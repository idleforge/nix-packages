{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idleforge.dev/schemas/repository/v1.json",
  "title": "IdleForge repository participation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "repository",
    "development",
    "participation",
    "profiles",
    "responsibilities",
    "capabilities",
    "workflow",
    "lifecycle",
    "fleet",
    "exemptions"
  ],
  "properties": {
    "contract": { "const": "idleforge.repository/v1" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mission", "group"],
      "properties": {
        "id": { "$ref": "#/$defs/repositoryId" },
        "mission": { "type": "string", "minLength": 1 },
        "group": {
          "enum": ["infrastructure", "product", "research", "workspace"]
        }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "path"],
      "properties": {
        "contract": { "const": "idleforge.repository-development/v1" },
        "path": { "const": "repository-development.json" }
      }
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {
          "enum": [
            "product-emitting",
            "environment-only",
            "research-spike-only",
            "explicit-exemption"
          ]
        },
        "exemptionReason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "class": { "const": "explicit-exemption" } },
            "required": ["class"]
          },
          "then": { "required": ["exemptionReason"] },
          "else": { "not": { "required": ["exemptionReason"] } }
        }
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "repository-neutral",
          "python",
          "typescript-node",
          "go",
          "rust",
          "android",
          "documentation",
          "service",
          "monorepo",
          "home-assistant",
          "experimental"
        ]
      }
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/responsibility" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers", "harnessBindings", "fleetCapabilities"],
      "properties": {
        "providers": {
          "type": "array",
          "items": { "$ref": "#/$defs/providerCapability" }
        },
        "harnessBindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityReference" }
        },
        "fleetCapabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityReference" }
        }
      }
    },
    "instructions": { "$ref": "#/$defs/instructions" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap",
        "validate",
        "build",
        "install",
        "health",
        "provenance",
        "rollback"
      ],
      "properties": {
        "bootstrap": { "$ref": "#/$defs/operation" },
        "validate": { "$ref": "#/$defs/operation" },
        "build": { "$ref": "#/$defs/operation" },
        "install": { "$ref": "#/$defs/operation" },
        "health": { "$ref": "#/$defs/operation" },
        "provenance": { "$ref": "#/$defs/operation" },
        "rollback": { "$ref": "#/$defs/operation" }
      }
    },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "orchestration", "observations"],
      "properties": {
        "inventory": { "type": "boolean" },
        "orchestration": {
          "enum": ["none", "observe-only", "proposal-only", "rollout"]
        },
        "observations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "conformance",
              "drift",
              "health",
              "provenance",
              "security",
              "updates"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "orchestration": { "const": "rollout" } },
            "required": ["orchestration"]
          },
          "then": {
            "properties": { "inventory": { "const": true } }
          }
        }
      ]
    },
    "preservedDependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/preservedDependency" }
    },
    "responsibilityMigrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/responsibilityMigration" }
    },
    "exemptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exemption" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "overrides", "projection"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "releaseUnit"],
          "properties": {
            "repository": { "const": "idleforge/agents" },
            "releaseUnit": { "const": "agents.coding-harness-runtime" }
          }
        },
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/instructionOverride" }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": {
              "enum": ["auto", "dependency-only", "tracked-required"]
            }
          }
        }
      }
    },
    "instructionOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "disposition", "reason"],
      "properties": {
        "capability": { "$ref": "#/$defs/identifier" },
        "disposition": { "enum": ["include", "exclude"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "roles"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "summary": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mission",
              "implementation-provider",
              "configuration-projection",
              "hydration-deployment",
              "fleet-observation-enforcement"
            ]
          }
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryId" }
        }
      }
    },
    "capabilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "purpose": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "minLength": 1 }
      }
    },
    "providerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "provider",
        "access",
        "availability",
        "docs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "purpose": { "type": "string", "minLength": 1 },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "$ref": "#/$defs/repositoryId" },
            "artifact": { "$ref": "#/$defs/identifier" }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "library": { "type": "string", "minLength": 1 },
            "endpoint": { "type": "string", "minLength": 1 }
          }
        },
        "availability": { "type": "string", "minLength": 1 },
        "failure": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "minLength": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stance",
        "integrationBranch",
        "taskBranches",
        "pullRequests",
        "worktrees",
        "cleanup"
      ],
      "properties": {
        "stance": { "enum": ["direct", "reviewed", "staged"] },
        "integrationBranch": { "type": "string", "minLength": 1 },
        "promotionBranch": { "type": "string", "minLength": 1 },
        "taskBranches": { "enum": ["prohibited", "optional", "required"] },
        "pullRequests": { "enum": ["prohibited", "optional", "required"] },
        "worktrees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": { "enum": ["prohibited", "optional", "required"] },
            "root": { "type": "string", "minLength": 1 },
            "naming": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "policy": { "enum": ["optional", "required"] } },
                "required": ["policy"]
              },
              "then": { "required": ["root", "naming"] }
            }
          ]
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["afterIntegration", "evidence"],
          "properties": {
            "afterIntegration": { "type": "boolean" },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["clean", "validated", "published", "contained"]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "stance": { "const": "staged" } },
            "required": ["stance"]
          },
          "then": { "required": ["promotionBranch"] }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability"],
      "properties": {
        "applicability": {
          "enum": ["required", "optional", "not-applicable"]
        },
        "command": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": { "enum": ["required", "optional"] }
            },
            "required": ["applicability"]
          },
          "then": { "required": ["command"] }
        },
        {
          "if": {
            "properties": { "applicability": { "const": "not-applicable" } },
            "required": ["applicability"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "preservedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerRepository",
        "upstreamIdentity",
        "digest",
        "approvalChannel",
        "hydrationOwner",
        "rollbackRetention"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "providerRepository": { "$ref": "#/$defs/repositoryId" },
        "upstreamIdentity": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "approvalChannel": { "type": "string", "minLength": 1 },
        "hydrationOwner": { "$ref": "#/$defs/repositoryId" },
        "collector": { "type": "string", "minLength": 1 },
        "rollbackRetention": { "type": "string", "minLength": 1 }
      }
    },
    "responsibilityMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsibility", "targetOwner", "condition"],
      "properties": {
        "responsibility": { "$ref": "#/$defs/identifier" },
        "targetOwner": { "$ref": "#/$defs/repositoryId" },
        "condition": { "type": "string", "minLength": 1 }
      }
    },
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "justification",
        "owner",
        "status",
        "removalCondition",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "requirement": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["temporary", "permanent"] },
        "reviewBy": { "type": "string", "format": "date" },
        "removalCondition": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "temporary" } },
            "required": ["status"]
          },
          "then": { "required": ["reviewBy"] }
        }
      ]
    }
  }
}
